# Copy this file to `keystore.properties` (same directory) and fill in real
# values. keystore.properties is gitignored — it holds passwords and must stay
# off version control. See ../RELEASE.md for how to generate the keystore.
#
# storeFile is resolved relative to the android/ directory.

storeFile=byteyourfork-release.jks
storePassword=CHANGE_ME
keyAlias=byteyourfork
keyPassword=CHANGE_ME
